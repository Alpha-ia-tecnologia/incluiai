{
  "name": "educa-especial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prisma-db.mjs gerar",
    "dev": "next dev",
    "prebuild": "node scripts/prisma-db.mjs gerar",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/prisma-db.mjs gerar",
    "db:setup": "node scripts/prisma-db.mjs tabelas && node prisma/seed.mjs",
    "db:resources": "node scripts/prisma-db.mjs tabelas && node prisma/seed-resources.mjs",
    "db:configurar": "node scripts/prisma-db.mjs configurar",
    "db:tabelas": "node scripts/prisma-db.mjs tabelas",
    "db:migracao": "node scripts/prisma-db.mjs migracao",
    "db:admin": "node scripts/prisma-db.mjs admin",
    "db:contas-teste": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prisma-db.mjs contas-teste",
    "test:e2e": "node e2e-test.mjs",
    "test:unit": "node --test \"src/lib/**/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "docx": "9.5.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "nodemailer": "7.0.13",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
